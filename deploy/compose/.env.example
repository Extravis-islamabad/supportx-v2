# SupportX v2 local dev stack: settings for deploy/compose/docker-compose.yml.
#
# `make dev-init` copies this file to .env (git-ignored) and replaces every `__generate__` value
# with a random secret, so no two machines share passwords and nothing secret lands in git.
# DEV ONLY: none of these values or services are hardened for production.
#
# Passwords are baked into the data volumes on first start. If you change one later, run
# `make dev-reset` (deletes local dev data) so the services are re-initialised with it.

# --- Compose -------------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=supportx-dev

# --- PostgreSQL 16 + pgvector --------------------------------------------------------------------
# Bootstrap superuser: used only by init scripts and dev-check, never by the application.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=__generate__
# Owner of the supportx database and its schema; Alembic migrations run as this role (WP-005).
SUPPORTX_MIGRATOR_PASSWORD=__generate__
# Runtime role for the API and workers: not superuser, not owner, NO BYPASSRLS (CLAUDE.md rule a).
SUPPORTX_APP_PASSWORD=__generate__
# Outbox relay (WP-007): reads and marks outbox rows of every tenant, no access to business tables.
SUPPORTX_RELAY_PASSWORD=__generate__
KEYCLOAK_DB_PASSWORD=__generate__
TEMPORAL_DB_PASSWORD=__generate__

# --- Valkey ----------------------------------------------------------------------------------------
VALKEY_PASSWORD=__generate__

# --- Keycloak --------------------------------------------------------------------------------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=__generate__
# Client secrets of the supportx realm's console and portal clients (confidential to the BFF).
# Injected into the realm import (deploy/compose/keycloak/supportx-realm.json) and backend/.env.
KEYCLOAK_CONSOLE_CLIENT_SECRET=__generate__
KEYCLOAK_PORTAL_CLIENT_SECRET=__generate__

# --- API sessions (WP-006) -------------------------------------------------------------------------
# Key material for encrypting BFF session records in Valkey (AES-256-GCM).
SESSION_SECRET=__generate__

# --- Centrifugo ------------------------------------------------------------------------------------
CENTRIFUGO_TOKEN_HMAC_SECRET=__generate__
CENTRIFUGO_API_KEY=__generate__
CENTRIFUGO_ADMIN_PASSWORD=__generate__
CENTRIFUGO_ADMIN_SECRET=__generate__

# --- MinIO -----------------------------------------------------------------------------------------
MINIO_ROOT_USER=supportx
MINIO_ROOT_PASSWORD=__generate__
MINIO_BUCKET=attachments

# --- ClickHouse ------------------------------------------------------------------------------------
CLICKHOUSE_USER=supportx
CLICKHOUSE_PASSWORD=__generate__
CLICKHOUSE_DB=supportx_analytics

# --- Host ports (all bound to 127.0.0.1) -----------------------------------------------------------
# Every port sits in the 2xxxx range so the stack does not collide with other local projects
# (5432, 6379, 4222, 8025 ... are commonly taken). Change any of them here if they clash.
POSTGRES_PORT=25432
PGBOUNCER_PORT=26432
VALKEY_PORT=26379
NATS_PORT=24222
NATS_MONITOR_PORT=28222
KEYCLOAK_PORT=28080
KEYCLOAK_MANAGEMENT_PORT=28090
CENTRIFUGO_PORT=28000
MINIO_API_PORT=29000
MINIO_CONSOLE_PORT=29001
MAILPIT_SMTP_PORT=21025
MAILPIT_WEB_PORT=28025
TEMPORAL_PORT=27233
TEMPORAL_UI_PORT=28233
OPENSEARCH_PORT=29200
CLICKHOUSE_HTTP_PORT=28123
CLICKHOUSE_NATIVE_PORT=29010
CLAMAV_PORT=23310
