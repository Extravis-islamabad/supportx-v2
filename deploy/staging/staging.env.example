# /etc/supportx-staging/staging.env: settings of deploy/staging/nightly.sh (runbook step 7).
# Copy this file there and change PUBLIC_URL to the laptop's LAN name. No secrets here.
PUBLIC_URL=https://sx-staging.lan
CA_FILE=/etc/supportx-staging/ca.crt
KUBECONFIG=/home/sxstaging/.kube/config
export KUBECONFIG
# Defaults, change only if needed:
# CHECKOUT=/srv/supportx-staging/checkout
# NAMESPACE=supportx
# RELEASE=supportx
# KEEP_DAYS=14
# HELM_TIMEOUT=15m
# LOCAL_VALUES=/etc/supportx-staging/values-local.yaml
# corepack fetches the pinned pnpm without asking (the job has no terminal).
COREPACK_ENABLE_DOWNLOAD_PROMPT=0
export COREPACK_ENABLE_DOWNLOAD_PROMPT
