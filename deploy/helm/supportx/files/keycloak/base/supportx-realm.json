{
  "realm": "supportx",
  "displayName": "SupportX",
  "loginTheme": "supportx",
  "enabled": true,
  "organizationsEnabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "editUsernameAllowed": false,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en",
    "ar",
    "ur"
  ],
  "defaultLocale": "en",
  "passwordPolicy": "length(12) and maxLength(128) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and notUsername and notEmail and passwordHistory(5) and passwordBlacklist(supportx-breached.txt)",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 43200,
  "revokeRefreshToken": false,
  "roles": {
    "realm": [
      {
        "name": "tenant_admin",
        "description": "Administers the tenant's SupportX configuration."
      },
      {
        "name": "technician",
        "description": "Works tickets in the technician console."
      },
      {
        "name": "requester",
        "description": "Raises and follows requests in the self-service portal."
      }
    ]
  },
  "clients": [
    {
      "clientId": "supportx-console",
      "name": "SupportX Console",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${SUPPORTX_KC_CONSOLE_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "${SUPPORTX_KC_CONSOLE_ORIGIN}/api/v1/auth/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${SUPPORTX_KC_CONSOLE_ORIGIN}/*",
        "backchannel.logout.session.required": "true",
        "use.refresh.tokens": "true"
      },
      "protocolMappers": [
        {
          "name": "organization-membership",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-organization-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "supportx_organizations",
            "jsonType.label": "JSON",
            "multivalued": "true",
            "addOrganizationAttributes": "true",
            "addOrganizationId": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "supportx_roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "supportx-portal",
      "name": "SupportX Portal",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${SUPPORTX_KC_PORTAL_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "${SUPPORTX_KC_PORTAL_ORIGIN}/api/v1/auth/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${SUPPORTX_KC_PORTAL_ORIGIN}/*",
        "backchannel.logout.session.required": "true",
        "use.refresh.tokens": "true"
      },
      "protocolMappers": [
        {
          "name": "organization-membership",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-organization-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "supportx_organizations",
            "jsonType.label": "JSON",
            "multivalued": "true",
            "addOrganizationAttributes": "true",
            "addOrganizationId": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "supportx_roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ]
}
