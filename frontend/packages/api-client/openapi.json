{
  "components": {
    "schemas": {
      "CheckResponse": {
        "description": "One dependency's readiness.",
        "properties": {
          "critical": {
            "default": true,
            "description": "False for informational checks (event workers): they never cause a 503.",
            "title": "Critical",
            "type": "boolean"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Probe duration.",
            "title": "Latency Ms"
          },
          "reason": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FailureReason"
              },
              {
                "type": "null"
              }
            ],
            "description": "Why it failed, if it did."
          },
          "status": {
            "$ref": "#/components/schemas/CheckStatus"
          }
        },
        "required": [
          "status"
        ],
        "title": "CheckResponse",
        "type": "object"
      },
      "CheckStatus": {
        "description": "Outcome of one dependency check.",
        "enum": [
          "ok",
          "failed",
          "not_configured"
        ],
        "title": "CheckStatus",
        "type": "string"
      },
      "FailureReason": {
        "description": "Why a check failed. Stable codes only: raw exception text never leaves the server.",
        "enum": [
          "timeout",
          "unreachable",
          "auth_failed",
          "unexpected_response",
          "not_running",
          "stale_heartbeat",
          "error"
        ],
        "title": "FailureReason",
        "type": "string"
      },
      "FieldError": {
        "description": "One invalid input field.",
        "properties": {
          "code": {
            "description": "Stable machine code, e.g. `missing`.",
            "title": "Code",
            "type": "string"
          },
          "field": {
            "description": "Dotted path of the field, e.g. `body.title`.",
            "title": "Field",
            "type": "string"
          },
          "message_key": {
            "description": "Labels key the UI translates.",
            "title": "Message Key",
            "type": "string"
          },
          "params": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": "Params",
            "type": "object"
          }
        },
        "required": [
          "field",
          "code",
          "message_key"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Liveness: the process is up and serving.",
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "MeResponse": {
        "description": "Session summary for the UI.\n\n`csrf_token` must be sent as X-CSRF-Token on every POST/PUT/PATCH/DELETE; it is tied to this\nsession and changes when the session does.",
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          },
          "tenant": {
            "$ref": "#/components/schemas/TenantOut"
          },
          "tenants": {
            "items": {
              "$ref": "#/components/schemas/TenantOut"
            },
            "title": "Tenants",
            "type": "array"
          },
          "user": {
            "$ref": "#/components/schemas/UserOut"
          }
        },
        "required": [
          "user",
          "tenant",
          "tenants",
          "csrf_token"
        ],
        "title": "MeResponse",
        "type": "object"
      },
      "ProblemDetail": {
        "description": "RFC 9457 problem details, extended with SupportX's machine code and message key.",
        "properties": {
          "code": {
            "description": "Stable machine code clients switch on.",
            "title": "Code",
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "title": "Errors",
            "type": "array"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Request path that failed.",
            "title": "Instance"
          },
          "message_key": {
            "description": "Labels key the UI translates into the user's language.",
            "title": "Message Key",
            "type": "string"
          },
          "params": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": "Params",
            "type": "object"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "description": "Short, generic English summary (not for display).",
            "title": "Title",
            "type": "string"
          },
          "type": {
            "description": "URI reference identifying the problem type.",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "message_key"
        ],
        "title": "ProblemDetail",
        "type": "object"
      },
      "ReadinessResponse": {
        "description": "Readiness: every dependency this process needs, and which one failed.",
        "properties": {
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/CheckResponse"
            },
            "title": "Checks",
            "type": "object"
          },
          "degraded": {
            "description": "Informational checks that are not OK.",
            "items": {
              "type": "string"
            },
            "title": "Degraded",
            "type": "array"
          },
          "failed": {
            "items": {
              "type": "string"
            },
            "title": "Failed",
            "type": "array"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks",
          "failed"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "SwitchTenantRequest": {
        "description": "Which of the user's tenants to make active.",
        "properties": {
          "tenant_id": {
            "format": "uuid",
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "tenant_id"
        ],
        "title": "SwitchTenantRequest",
        "type": "object"
      },
      "TenantOut": {
        "description": "A tenant the user belongs to.",
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "TenantOut",
        "type": "object"
      },
      "TenantResponse": {
        "description": "The caller's tenant. `status` is a code; the UI renders it via labels.",
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/TenantStatus"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "status"
        ],
        "title": "TenantResponse",
        "type": "object"
      },
      "TenantStatus": {
        "description": "Lifecycle of a tenant. Stored as stable lowercase codes; the UI shows labels.",
        "enum": [
          "active",
          "suspended"
        ],
        "title": "TenantStatus",
        "type": "string"
      },
      "UserOut": {
        "description": "The logged-in user (in the active tenant).",
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "locale": {
            "enum": [
              "en",
              "ar",
              "ur"
            ],
            "title": "Locale",
            "type": "string"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          },
          "user_type": {
            "$ref": "#/components/schemas/UserType"
          }
        },
        "required": [
          "id",
          "email",
          "display_name",
          "locale",
          "user_type",
          "roles"
        ],
        "title": "UserOut",
        "type": "object"
      },
      "UserType": {
        "description": "Which app a user works in. Stored as a code; the UI shows a label.",
        "enum": [
          "technician",
          "requester"
        ],
        "title": "UserType",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "SupportX v2 Core API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/callback": {
      "get": {
        "description": "Keycloak sends the browser here. Creates a new session and sets the session cookie.\n\nFailures are RFC 9457 problems for API clients. A browser navigation (Accept: text/html) is\nsent back to its app with `?auth_error=<code>` instead, which the app shows as a translated\nmessage (CLAUDE.md rule d: no raw codes or JSON on screen).",
        "operationId": "callback_api_v1_auth_callback_get",
        "parameters": [
          {
            "in": "query",
            "name": "code",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Code"
            }
          },
          {
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "State"
            }
          },
          {
            "in": "query",
            "name": "error",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Error"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "summary": "Finish login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/login": {
      "get": {
        "description": "Redirect the browser to Keycloak (authorization code + PKCE, state, nonce).\n\n`returnTo` must be a same-origin relative path; anything else lands on `/`.",
        "operationId": "login_api_v1_auth_login_get",
        "parameters": [
          {
            "in": "query",
            "name": "app",
            "required": false,
            "schema": {
              "default": "console",
              "enum": [
                "console",
                "portal"
              ],
              "title": "App",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "returnTo",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 2048,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Returnto"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "summary": "Start login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "End this session and the Keycloak session; clears the cookie.",
        "operationId": "logout_api_v1_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "summary": "Log out",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "description": "The logged-in user, active tenant, switchable tenants and CSRF token.",
        "operationId": "me_api_v1_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "summary": "Current session",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/switch-tenant": {
      "post": {
        "description": "Make another of the user's tenants active. Issues a new session ID and CSRF token.",
        "operationId": "switch_tenant_api_v1_auth_switch_tenant_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SwitchTenantRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "summary": "Switch active tenant",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "Return 200 while the process runs.\n\nChecks no dependency, so a database outage never makes the orchestrator restart healthy API\npods.",
        "operationId": "get_health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "summary": "Liveness",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/organization/tenant": {
      "get": {
        "description": "Return the tenant of the request (401 `unauthenticated` without a session).",
        "operationId": "read_current_tenant_api_v1_organization_tenant_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "summary": "Current tenant",
        "tags": [
          "organization"
        ]
      }
    },
    "/api/v1/ready": {
      "get": {
        "description": "Return 200 when PostgreSQL, Valkey, NATS and Keycloak all answer within the timeout.\n\nOtherwise 503, naming the failing dependency with a reason code. The outbox relay and the\nconsumer worker are reported from their heartbeats (`outbox_relay`, `event_consumers`) but\nare informational: when they are down the response lists them under `degraded`, still 200.",
        "operationId": "get_ready_api_v1_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Unexpected server error."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "A dependency is not ready."
          }
        },
        "summary": "Readiness",
        "tags": [
          "system"
        ]
      }
    }
  }
}
