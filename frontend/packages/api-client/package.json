{
  "name": "@supportx/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed API client and TanStack Query hooks generated from the backend OpenAPI spec (architecture.md §9.2).",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "openapi-typescript ./openapi.json --output ./src/schema.ts",
    "check:schema": "openapi-typescript ./openapi.json --output ./src/schema.ts --check",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tanstack/react-query": "catalog:",
    "@types/react": "catalog:",
    "openapi-typescript": "^7.13.0",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "jsdom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/dom": "catalog:",
    "react-dom": "catalog:",
    "@types/react-dom": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-query": "catalog:",
    "react": "catalog:"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  }
}
