# Backend settings (app/core/config.py). Every variable has the SUPPORTX_ prefix; real environment
# variables override this file. For local development run `make backend-env`, which writes
# backend/.env (git-ignored) with the dev stack's generated credentials.

# dev | test | production. Production requires every *_URL below and turns API docs off.
SUPPORTX_PROFILE=dev
# SUPPORTX_HTTP_HOST=127.0.0.1
# SUPPORTX_HTTP_PORT=8000
# SUPPORTX_LOG_LEVEL=info                 # debug | info | warning | error
# SUPPORTX_LOG_FORMAT=                    # console | json (default: json in production)
# SUPPORTX_API_DOCS_ENABLED=              # default: on except in production

# Backing services checked by GET /api/v1/ready.
SUPPORTX_DATABASE_URL=postgresql://supportx_app:<password>@127.0.0.1:26432/supportx
SUPPORTX_VALKEY_URL=valkey://:<password>@127.0.0.1:26379/0
SUPPORTX_NATS_URL=nats://127.0.0.1:24222
# SUPPORTX_READINESS_TIMEOUT_SECONDS=2

# OpenTelemetry: spans always created; exported only if an exporter is set (none | console).
# SUPPORTX_TRACING_ENABLED=true
# SUPPORTX_TRACE_EXPORTER=none
