# SupportX v2 task runner. `make check` must be green before any task is reported done (CLAUDE.md).
.DEFAULT_GOAL := help
.PHONY: help setup lint typecheck test format check build precommit audit audit-backend audit-frontend labels-json \
	backend-dev backend-env openapi openapi-check openapi-diff schema-check \
	db-bootstrap db-migrate db-downgrade db-revision db-current db-seed db-guard custom-field-indexes dev-subscription e2e \
	worker-relay worker-consumers worker-fanout worker-indexes events-tail events-stats dlq-list dlq-replay events-schemas events-check \
	dev-init dev-up dev-up-full dev-down dev-ps dev-logs dev-check dev-reset \
	backend-lint backend-typecheck backend-test frontend-lint frontend-typecheck frontend-test \
	frontend-install-check keycloak-realm keycloak-theme keycloak-identity brand-assets chart-deps chart-lint images cluster-up cluster-secrets \
	deploy-dev cluster-test cluster-e2e cluster-down

BACKEND := cd backend &&
FRONTEND := cd frontend &&
PIP_AUDIT_VERSION := 2.10.1
OPENAPI_FILE := ../frontend/packages/api-client/openapi.json
EVENT_SCHEMAS := ../docs/architecture/event-schemas.json
EVENTS_CLI := $(BACKEND) uv run python -m workers.events_cli
# Local dev stack (WP-002, docs/dev-setup.md). `--profile full` on down/ps/logs so they cover every
# service whichever profile started it; it never starts anything by itself.
DEV_DIR := deploy/compose
COMPOSE := docker compose --project-directory $(DEV_DIR) -f $(DEV_DIR)/docker-compose.yml
DEV_ENV := $(DEV_DIR)/.env

help: ## List targets
	@grep -E '^[a-z-]+:.*## ' $(MAKEFILE_LIST) | awk -F':.*## ' '{printf "  %-20s %s\n", $$1, $$2}'

setup: ## Install backend (uv, Python 3.12) and frontend (pnpm) deps, install git hooks
	$(BACKEND) uv sync
	$(FRONTEND) pnpm install --frozen-lockfile
	uv run --project backend pre-commit install

lint: backend-lint frontend-lint ## Lint everything (ruff, import-linter, OpenAPI + event schema drift, ESLint, Prettier)

typecheck: backend-typecheck frontend-typecheck ## Type-check everything (mypy strict, tsc strict)

test: backend-test frontend-test ## Run all tests (pytest, Vitest)

check: frontend-install-check lint typecheck test ## Lockfile install as CI does, then lint + typecheck + test

format: ## Auto-format and auto-fix everything
	$(BACKEND) uv run ruff format . && uv run ruff check --fix .
	$(FRONTEND) pnpm format

backend-env: ## Create backend/.env pointing the API at the local dev stack (never overwrites)
	@bash $(DEV_DIR)/scripts/backend-env.sh

backend-dev: ## Run the API with auto-reload on http://127.0.0.1:8000 (needs backend/.env for /ready)
	@test -f backend/.env || bash $(DEV_DIR)/scripts/backend-env.sh || true
	$(BACKEND) uv run uvicorn app.main:create_app --factory --reload --host 127.0.0.1 --port 8000 \
		--no-access-log --no-server-header

# --- Database (WP-005). Alembic runs as supportx_migrator straight to PostgreSQL, using
# SUPPORTX_MIGRATION_DATABASE_URL (backend/.env from `make backend-env`, or the environment).

db-bootstrap: ## Create missing database roles/grants (idempotent; never changes data or passwords)
	$(BACKEND) uv run python -m tooling.db_bootstrap --database supportx

db-migrate: db-bootstrap ## Apply all migrations (upgrade to head)
	$(BACKEND) uv run alembic upgrade head

db-downgrade: ## Roll back ONE migration (asks you to type "yes"; may drop tables and data)
	@cd backend && uv run alembic current
	@printf 'This rolls back the latest migration and can DROP tables and their data.\nType "yes" to continue: '; \
	read answer; if [ "$$answer" != "yes" ]; then echo "Cancelled. Nothing was changed."; exit 1; fi
	$(BACKEND) uv run alembic downgrade -1

db-revision: ## New autogenerated migration: make db-revision m="add work items"
	@test -n "$(m)" || { echo 'usage: make db-revision m="short description"'; exit 2; }
	$(BACKEND) uv run alembic revision --autogenerate -m "$(m)"

db-current: ## Show the database's current migration
	$(BACKEND) uv run alembic current

db-seed: ## Create the dev tenants and their plans if missing (idempotent, never deletes or updates)
	$(BACKEND) uv run python -m tooling.seed_dev

custom-field-indexes: ## One index pass now, as the index worker does (CONCURRENTLY; D-088)
	$(BACKEND) uv run python -m tooling.custom_field_indexes

db-guard: ## Check every table's tenant isolation (RLS) in the dev database
	$(BACKEND) uv run python -m tooling.rls_guard

dev-subscription: ## Show or change a dev tenant's plan: TENANT=demo|other|<uuid> ARGS="--technicians 1"
	$(BACKEND) uv run python -m tooling.dev_subscription --tenant $(or $(TENANT),demo) $(ARGS)

# --- Event bus (WP-007, docs/architecture/events.md). Workers read backend/.env (make backend-env).

worker-relay: ## Run the outbox relay (outbox table -> NATS JetStream) until Ctrl+C
	$(BACKEND) uv run python -m workers.outbox_relay

worker-consumers: ## Run every module consumer (dev profile: logs every event) until Ctrl+C
	$(BACKEND) uv run python -m workers.consumers

worker-indexes: ## Run the custom field index worker (builds requested indexes, D-088) until Ctrl+C
	$(BACKEND) uv run python -m workers.custom_field_indexes

worker-fanout: ## Run the realtime fan-out (events -> Centrifugo -> live screens) until Ctrl+C
	$(BACKEND) uv run python -m workers.realtime_fanout

events-tail: ## Watch events live: make events-tail [tenant=<id>] [type=identity_access.>] [since=10m|all]
	$(EVENTS_CLI) tail $(if $(tenant),--tenant $(tenant)) $(if $(type),--type '$(type)') \
		$(if $(since),--since $(since))

events-stats: ## Stream sizes, dead-letter count and worker heartbeats
	$(EVENTS_CLI) stats

dlq-list: ## List dead letters: make dlq-list [consumer=<name>]
	$(EVENTS_CLI) dlq-list $(if $(consumer),--consumer $(consumer))

dlq-replay: ## Replay dead letters to their consumer: make dlq-replay seq=<n> | all=1 [consumer=<name>]
	$(EVENTS_CLI) dlq-replay $(if $(seq),--seq $(seq)) $(if $(all),--all) \
		$(if $(consumer),--consumer $(consumer))

labels-json: ## Export the label dictionary for the backend (D-100 D7, ADR-034)
	node frontend/packages/labels/scripts/export-json.js backend/app/shared/labels/resources.json

events-schemas: ## Export every event schema to docs/architecture/event-schemas.json
	$(BACKEND) uv run python -m tooling.event_schemas write $(EVENT_SCHEMAS)

events-check: ## Fail on an outdated schema export or a breaking event change (base=<file> in CI)
	$(BACKEND) uv run python -m tooling.event_schemas check $(EVENT_SCHEMAS) $(if $(base),--base $(base))

openapi: ## Export the OpenAPI 3.1 contract and regenerate the TypeScript API types (D-022)
	$(BACKEND) uv run python -m tooling.export_openapi $(OPENAPI_FILE)
	$(FRONTEND) pnpm --filter @supportx/api-client generate

openapi-check: ## Fail if the committed openapi.json is out of date, or accepted breaks outlive the public API (D-095)
	$(BACKEND) uv run python -m tooling.export_openapi --check $(OPENAPI_FILE)
	$(BACKEND) uv run python -m tooling.openapi_diff --check-accepted

openapi-diff: ## Fail on breaking API changes: make openapi-diff base=<openapi.json of the target branch>
	@test -n "$(base)" || { echo 'usage: make openapi-diff base=path/to/old/openapi.json'; exit 2; }
	$(BACKEND) uv run python -m tooling.openapi_diff $(abspath $(base)) $(OPENAPI_FILE)

schema-check: ## Fail if api-client/src/schema.ts is out of date (frontend lint, CI)
	$(FRONTEND) pnpm --filter @supportx/api-client check:schema

e2e: ## Playwright journeys + axe (needs dev-up, backend-dev, worker-relay, worker-consumers and the console dev server)
	$(FRONTEND) pnpm --filter @supportx/e2e e2e

build: ## Production builds of the console and portal
	$(FRONTEND) pnpm build

precommit: ## Run every pre-commit hook against all files (as CI does)
	uv run --project backend pre-commit run --all-files --show-diff-on-failure

audit: audit-backend audit-frontend ## Dependency vulnerability scan: lists all, fails on high/critical

# pip-audit has no severity filter; tooling/vuln_gate.py adds it (exits 1 on high/critical/unknown).
# pip-audit itself exits 1 whenever it finds anything, so only a missing report counts as an error.
audit-backend:
	@tmp=$$(mktemp -d) && cd backend && \
	uv export --frozen --format requirements-txt --all-groups --no-emit-project --quiet \
		-o $$tmp/requirements.txt && \
	{ uvx pip-audit@$(PIP_AUDIT_VERSION) -r $$tmp/requirements.txt --disable-pip \
		--progress-spinner off --format json -o $$tmp/pip-audit.json || test -s $$tmp/pip-audit.json; } && \
	uv run python -m tooling.vuln_gate $$tmp/pip-audit.json

# First run lists every advisory; the second fails only on high/critical.
audit-frontend:
	$(FRONTEND) pnpm audit || true
	$(FRONTEND) pnpm audit --audit-level high

backend-lint:
	$(BACKEND) uv run ruff check . && uv run ruff format --check . && uv run lint-imports
	$(MAKE) openapi-check events-check
	$(BACKEND) uv run python -m tooling.keycloak_realm --check
	$(BACKEND) uv run python -m tooling.brand_assets --check

backend-typecheck:
	$(BACKEND) uv run mypy

backend-test:
	$(BACKEND) uv run pytest

# Exactly CI's install (WP-012 follow-up d): fails here, not after a push, when the lockfile or
# pnpm's build-script approvals (pnpm-workspace.yaml allowBuilds) are out of date.
frontend-install-check:
	$(FRONTEND) CI=true pnpm install --frozen-lockfile

frontend-lint:
	$(FRONTEND) pnpm lint && pnpm format:check
	$(MAKE) schema-check

frontend-typecheck:
	$(FRONTEND) pnpm typecheck

frontend-test:
	$(FRONTEND) pnpm test

# --- Local dev stack -----------------------------------------------------------------------------

$(DEV_ENV):
	@echo "deploy/compose/.env is missing; run 'make dev-init' first." && exit 1

dev-init: ## Create deploy/compose/.env with random dev secrets (never overwrites it)
	@bash $(DEV_DIR)/scripts/dev-init.sh

dev-up: $(DEV_ENV) ## Start the core dev services and wait until healthy
	$(COMPOSE) up -d --wait --wait-timeout 300
	$(COMPOSE) run --rm minio-init

dev-up-full: $(DEV_ENV) ## Start core + full (Temporal, OpenSearch, ClickHouse, ClamAV)
	$(COMPOSE) --profile full up -d --wait --wait-timeout 900
	$(COMPOSE) run --rm minio-init

dev-down: $(DEV_ENV) ## Stop all dev services; data volumes are KEPT
	$(COMPOSE) --profile full --profile setup down --remove-orphans

dev-ps: $(DEV_ENV) ## Show dev services and their health
	$(COMPOSE) --profile full ps --all

dev-logs: $(DEV_ENV) ## Follow logs (one service: make dev-logs s=postgres)
	$(COMPOSE) --profile full logs -f --tail=100 $(s)

dev-check: $(DEV_ENV) ## Verify every running dev service really works (PASS/FAIL table)
	@bash $(DEV_DIR)/scripts/dev-check.sh

dev-reset: $(DEV_ENV) ## DELETE all dev data volumes (asks you to type "yes" first)
	@bash $(DEV_DIR)/scripts/dev-reset.sh

# --- Kubernetes (WP-014, docs/deployment.md). k3s pinned in deploy/k3d/cluster.yaml (D9). ---------
CHART := deploy/helm/supportx
NAMESPACE := supportx
K3D_CLUSTER := supportx
IMAGE_TAG := dev
GIT_SHA := $(shell git rev-parse --short HEAD 2>/dev/null || echo unknown)

keycloak-realm: ## Regenerate the production (base) Keycloak realm from the dev realm
	$(BACKEND) uv run python -m tooling.keycloak_realm

keycloak-theme: $(DEV_ENV) ## Give the dev realm the SupportX login theme if it has none (never overwrites a chosen one)
	@env_value() { grep "^$$1=" $(CURDIR)/$(DEV_ENV) | cut -d= -f2-; }; \
	cd backend && SUPPORTX_KEYCLOAK_URL="http://localhost:$$(env_value KEYCLOAK_PORT || echo 28080)" \
	SUPPORTX_KEYCLOAK_ADMIN_USER="$$(env_value KEYCLOAK_ADMIN_USER)" \
	SUPPORTX_KEYCLOAK_ADMIN_PASSWORD="$$(env_value KEYCLOAK_ADMIN_PASSWORD)" \
	SUPPORTX_KEYCLOAK_WAIT_SECONDS=60 uv run python -m tooling.keycloak_theme

keycloak-identity: $(DEV_ENV) ## Set up the service account SupportX manages SSO and sessions with (idempotent)
	@env_value() { grep "^$$1=" $(CURDIR)/$(DEV_ENV) | cut -d= -f2-; }; \
	cd backend && SUPPORTX_KEYCLOAK_URL="http://localhost:$$(env_value KEYCLOAK_PORT || echo 28080)" \
	SUPPORTX_KEYCLOAK_ADMIN_USER="$$(env_value KEYCLOAK_ADMIN_USER)" \
	SUPPORTX_KEYCLOAK_ADMIN_PASSWORD="$$(env_value KEYCLOAK_ADMIN_PASSWORD)" \
	SUPPORTX_KEYCLOAK_IDENTITY_CLIENT_SECRET="$$(env_value KEYCLOAK_IDENTITY_CLIENT_SECRET)" \
	SUPPORTX_KEYCLOAK_WAIT_SECONDS=60 uv run python -m tooling.keycloak_identity

brand-assets: ## Regenerate logos, favicons and the Keycloak theme from docs/brand (branding.md)
	$(BACKEND) uv run python -m tooling.brand_assets

chart-deps: ## Download the chart's pinned dependencies (NATS, Valkey) from Chart.lock
	helm repo add nats https://nats-io.github.io/k8s/helm/charts/ --force-update >/dev/null
	helm repo add valkey https://valkey.io/valkey-helm/ --force-update >/dev/null
	helm dependency build $(CHART)

chart-lint: chart-deps ## Lint and render the chart for every profile (kubeconform too, if installed)
	@bash deploy/scripts/chart-lint.sh

images: ## Build the INTERNAL/DEV backend and web images for this machine's architecture
	docker build -f deploy/images/backend.Dockerfile -t supportx-backend:$(IMAGE_TAG) \
		--build-arg VERSION=0.1.0-dev --build-arg REVISION=$(GIT_SHA) .
	docker build -f deploy/images/web.Dockerfile -t supportx-web:$(IMAGE_TAG) \
		--build-arg VERSION=0.1.0-dev --build-arg REVISION=$(GIT_SHA) .

cluster-up: ## Create the local k3d cluster (k3s v1.36.5) and its prerequisites (CloudNativePG)
	@bash deploy/k3d/up.sh

cluster-secrets: ## Create the chart's Secrets with random values (never overwrites existing ones)
	@bash deploy/scripts/secrets.sh $(NAMESPACE)

# Our smoke pod checks Valkey auth itself; the upstream chart's auth test pod is excluded: our
# NetworkPolicy refuses its connection, which it reads as "auth enforced" (WP-020).
HELM_TEST = helm test supportx -n $(NAMESPACE) --logs --filter '!name=supportx-valkey-test-auth-existing'

deploy-dev: images chart-deps cluster-secrets ## Build, import and install/upgrade the dev profile on k3d
	k3d image import supportx-backend:$(IMAGE_TAG) supportx-web:$(IMAGE_TAG) -c $(K3D_CLUSTER)
	helm upgrade --install supportx $(CHART) -n $(NAMESPACE) -f $(CHART)/values-dev.yaml \
		--set-string podAnnotations.rollout="$(GIT_SHA)-$$(date +%s)" --wait --timeout 15m
	$(HELM_TEST)

cluster-test: ## helm test: every internal route answers and Valkey enforces auth
	$(HELM_TEST)

cluster-e2e: ## Playwright journeys against the k3d cluster (ARGS="tests/login.spec.ts" for one file)
	@bash deploy/k3d/e2e.sh $(ARGS)

cluster-down: ## DELETE the k3d cluster and all its data (asks you to type "yes" first)
	@printf 'This deletes the k3d cluster "$(K3D_CLUSTER)" and every volume in it.\nType "yes" to continue: '; \
		read answer; [ "$$answer" = "yes" ] || { echo "Cancelled."; exit 1; }
	k3d cluster delete $(K3D_CLUSTER)
