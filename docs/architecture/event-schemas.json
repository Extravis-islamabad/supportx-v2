{
  "envelope": {
    "$defs": {
      "Actor": {
        "description": "Who caused the event: a user (by ID) or a system component (by name).",
        "properties": {
          "id": {
            "maxLength": 128,
            "title": "Id",
            "type": "string"
          },
          "type": {
            "enum": [
              "user",
              "system"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "id"
        ],
        "title": "Actor",
        "type": "object"
      }
    },
    "description": "What is stored in the outbox and published to NATS, byte for byte.",
    "properties": {
      "actor": {
        "$ref": "#/$defs/Actor"
      },
      "aggregate_id": {
        "maxLength": 128,
        "title": "Aggregate Id",
        "type": "string"
      },
      "aggregate_type": {
        "title": "Aggregate Type",
        "type": "string"
      },
      "aggregate_version": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Version of the aggregate after the change, if versioned.",
        "title": "Aggregate Version"
      },
      "causation_id": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "The event that caused this one, when a consumer emits it.",
        "title": "Causation Id"
      },
      "correlation_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Request ID of the API call (or the causing event's).",
        "title": "Correlation Id"
      },
      "event_id": {
        "description": "UUIDv7; also the NATS message ID (deduplication).",
        "format": "uuid",
        "title": "Event Id",
        "type": "string"
      },
      "event_type": {
        "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
        "title": "Event Type",
        "type": "string"
      },
      "occurred_at": {
        "format": "date-time",
        "title": "Occurred At",
        "type": "string"
      },
      "payload": {
        "additionalProperties": true,
        "title": "Payload",
        "type": "object"
      },
      "schema_version": {
        "minimum": 1,
        "title": "Schema Version",
        "type": "integer"
      },
      "tenant_id": {
        "format": "uuid",
        "title": "Tenant Id",
        "type": "string"
      },
      "traceparent": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "W3C trace context.",
        "title": "Traceparent"
      }
    },
    "required": [
      "event_id",
      "event_type",
      "schema_version",
      "tenant_id",
      "actor",
      "occurred_at",
      "aggregate_type",
      "aggregate_id",
      "payload"
    ],
    "title": "EventEnvelope",
    "type": "object"
  },
  "events": {
