{
  "name": "supportx-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "SupportX technician and admin app: Expo SDK 58, local builds only (D-157, docs/architecture/mobile.md).",
  "main": "expo-router/entry",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest --ci",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@supportx/api-client": "link:../frontend/packages/api-client",
    "@supportx/labels": "link:../frontend/packages/labels",
    "@supportx/realtime": "link:../frontend/packages/realtime",
    "@supportx/ui": "link:../frontend/packages/ui",
    "@tanstack/react-query": "^5.104.5",
    "centrifuge": "5.8.0",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "i18next": "^26.5.4",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-i18next": "^17.1.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.3.0",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.13",
    "prettier": "^3.9.10",
    "test-renderer": "^1.3.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
